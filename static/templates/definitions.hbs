<div class="siedlung-definitions">
  <nav class="siedlung-tabs">
    <button type="button" class="{{#if isBuildings}}active{{/if}}" data-action="switchTab" data-tab="buildings">{{localize "SIEDLUNG.editor.tabs.buildings"}}</button>
    <button type="button" class="{{#if isResource}}active{{/if}}" data-action="switchTab" data-tab="resource">{{localize "SIEDLUNG.editor.tabs.resource"}}</button>
    <button type="button" class="{{#if isWorker}}active{{/if}}" data-action="switchTab" data-tab="worker">{{localize "SIEDLUNG.editor.tabs.worker"}}</button>
    <button type="button" class="{{#if isStats}}active{{/if}}" data-action="switchTab" data-tab="stat">{{localize "SIEDLUNG.editor.tabs.stat"}}</button>
    <button type="button" class="{{#if isTerrain}}active{{/if}}" data-action="switchTab" data-tab="terrain">{{localize "SIEDLUNG.editor.tabs.terrain"}}</button>
    <button type="button" class="{{#if isLaws}}active{{/if}}" data-action="switchTab" data-tab="laws">{{localize "SIEDLUNG.editor.tabs.laws"}}</button>
    <button type="button" class="{{#if isTriggers}}active{{/if}}" data-action="switchTab" data-tab="triggers">{{localize "SIEDLUNG.editor.tabs.triggers"}}</button>
    <button type="button" class="{{#if isRoads}}active{{/if}}" data-action="switchTab" data-tab="roads">{{localize "SIEDLUNG.editor.tabs.roads"}}</button>
  </nav>

  {{#if isBuildings}}
  <section>
    <header>
      <h3>{{localize "SIEDLUNG.editor.categories"}}</h3>
      <button type="button" data-action="addCategory"><i class="fa-solid fa-plus"></i> {{localize "SIEDLUNG.editor.addCategory"}}</button>
    </header>
    <ul class="cat-list">
      {{#each categories}}
      <li>
        <input type="color" value="{{color}}" data-cat-field="color" data-id="{{id}}">
        <input type="text" value="{{label}}" data-cat-field="label" data-id="{{id}}" maxlength="40">
        <button type="button" data-action="deleteCategory" data-id="{{id}}" title="{{localize 'SIEDLUNG.editor.deleteCategory'}}"><i class="fa-solid fa-trash"></i></button>
      </li>
      {{/each}}
    </ul>
  </section>

  <section>
    <header>
      <h3>{{localize "SIEDLUNG.editor.buildings"}}</h3>
      <button type="button" data-action="addBuilding"><i class="fa-solid fa-plus"></i> {{localize "SIEDLUNG.editor.addBuilding"}}</button>
    </header>
    {{#each groups}}
    <details open style="--cat: {{color}}">
      <summary>{{label}}</summary>
      <ul class="bld-list">
        {{#each buildings}}
        <li>
          <span class="shape" style="--w: {{shape.w}}; --h: {{shape.h}}">
            {{#each shape.cells}}<i style="grid-column: {{col}}; grid-row: {{row}}"></i>{{/each}}
          </span>
          <span class="name">{{name}}</span>
          <span class="meta">{{count}} {{localize "SIEDLUNG.editor.fields"}}</span>
          <button type="button" data-action="editBuilding" data-id="{{id}}" title="{{localize 'SIEDLUNG.editor.edit'}}"><i class="fa-solid fa-pencil"></i></button>
          <button type="button" data-action="deleteBuilding" data-id="{{id}}" title="{{localize 'SIEDLUNG.editor.deleteBuilding'}}"><i class="fa-solid fa-trash"></i></button>
        </li>
        {{else}}
        <li class="empty">{{localize "SIEDLUNG.editor.empty"}}</li>
        {{/each}}
      </ul>
    </details>
    {{/each}}
  </section>
  {{else if isStats}}
  <section>
    <header>
      <h3>{{localize "SIEDLUNG.stats.title"}}</h3>
      <button type="button" data-action="addStat"><i class="fa-solid fa-plus"></i> {{localize "SIEDLUNG.editor.add"}}</button>
    </header>
    <p class="hint">{{localize "SIEDLUNG.stats.hint"}}</p>
    <ul class="stat-defs">
      {{#each stats}}
      <li>
        <span class="name">{{name}}</span>
        <span class="meta">{{summary}}</span>
        <button type="button" data-action="editStat" data-id="{{id}}" title="{{localize 'SIEDLUNG.editor.edit'}}"><i class="fa-solid fa-pencil"></i></button>
        <button type="button" data-action="deleteStat" data-id="{{id}}" title="{{localize 'SIEDLUNG.stats.delete'}}"><i class="fa-solid fa-trash"></i></button>
        {{#if strip}}<div class="strip" style="background: {{strip}}"></div>{{/if}}
      </li>
      {{/each}}
    </ul>
  </section>
  {{else if isLaws}}
  <section>
    <header>
      <h3>{{localize "SIEDLUNG.lawEditor.categories"}}</h3>
      <button type="button" data-action="addLawCategory"><i class="fa-solid fa-plus"></i> {{localize "SIEDLUNG.editor.add"}}</button>
    </header>
    <ul class="law-cat-list">
      {{#each lawCategories}}
      <li>
        <input type="text" value="{{label}}" data-lawcat-field="label" data-id="{{id}}" maxlength="40">
        <button type="button" data-action="deleteLawCategory" data-id="{{id}}" title="{{localize 'SIEDLUNG.lawEditor.deleteCategory'}}"><i class="fa-solid fa-trash"></i></button>
      </li>
      {{/each}}
    </ul>
  </section>
  <section>
    <header>
      <h3>{{localize "SIEDLUNG.lawEditor.laws"}}</h3>
      <button type="button" data-action="addLaw"><i class="fa-solid fa-plus"></i> {{localize "SIEDLUNG.editor.add"}}</button>
    </header>
    <p class="hint">{{localize "SIEDLUNG.lawEditor.hint"}}</p>
    {{#each lawGroups}}
    <details open>
      <summary>{{label}}</summary>
      <ul class="law-def-list">
        {{#each laws}}
        <li>
          <span class="name">{{name}}</span>
          <span class="meta">{{count}} {{localize "SIEDLUNG.lawEditor.optionsShort"}}</span>
          <button type="button" data-action="editLaw" data-id="{{id}}" title="{{localize 'SIEDLUNG.editor.edit'}}"><i class="fa-solid fa-pencil"></i></button>
          <button type="button" data-action="deleteLaw" data-id="{{id}}" title="{{localize 'SIEDLUNG.lawEditor.delete'}}"><i class="fa-solid fa-trash"></i></button>
        </li>
        {{else}}
        <li class="empty">{{localize "SIEDLUNG.editor.empty"}}</li>
        {{/each}}
      </ul>
    </details>
    {{/each}}
  </section>
  {{else if isTriggers}}
  <section>
    <header>
      <h3>{{localize "SIEDLUNG.triggers.title"}}</h3>
      <button type="button" data-action="addTrigger"><i class="fa-solid fa-plus"></i> {{localize "SIEDLUNG.editor.add"}}</button>
    </header>
    <p class="hint">{{localize "SIEDLUNG.triggers.hint"}}</p>
    <ul class="trigger-defs">
      {{#each triggers}}
      <li>
        <span class="name">{{name}}{{#if hidden}} <i class="fa-solid fa-eye-slash" title="{{localize 'SIEDLUNG.triggers.hidden'}}"></i>{{/if}}{{#if off}} <i class="fa-solid fa-power-off" title="{{localize 'SIEDLUNG.triggers.offByDefault'}}"></i>{{/if}}</span>
        <button type="button" data-action="editTrigger" data-id="{{id}}" title="{{localize 'SIEDLUNG.editor.edit'}}"><i class="fa-solid fa-pencil"></i></button>
        <button type="button" data-action="deleteTrigger" data-id="{{id}}" title="{{localize 'SIEDLUNG.triggers.delete'}}"><i class="fa-solid fa-trash"></i></button>
        <div class="meta">{{summary}}</div>
      </li>
      {{else}}
      <li class="empty">{{localize "SIEDLUNG.triggers.none"}}</li>
      {{/each}}
    </ul>
  </section>
  {{else if isRoads}}
  <section>
    <header>
      <h3>{{localize "SIEDLUNG.roads.title"}}</h3>
      <button type="button" data-action="addRoad"><i class="fa-solid fa-plus"></i> {{localize "SIEDLUNG.editor.add"}}</button>
    </header>
    <p class="hint">{{localize "SIEDLUNG.roads.editorHint"}}</p>
    <ul class="trigger-defs road-defs">
      {{#each roads}}
      <li>
        <span class="name"><i class="swatch" style="background: {{color}}"></i> {{name}}</span>
        <button type="button" data-action="editRoad" data-id="{{id}}" title="{{localize 'SIEDLUNG.editor.edit'}}"><i class="fa-solid fa-pencil"></i></button>
        <button type="button" data-action="deleteRoad" data-id="{{id}}" title="{{localize 'SIEDLUNG.roads.delete'}}"><i class="fa-solid fa-trash"></i></button>
        <div class="meta">{{summary}}</div>
      </li>
      {{else}}
      <li class="empty">{{localize "SIEDLUNG.roads.none"}}</li>
      {{/each}}
    </ul>
  </section>
  {{else if isTerrain}}
  <section>
    <header>
      <h3>{{localize "SIEDLUNG.terrainEditor.title"}}</h3>
      <button type="button" data-action="addTerrain"><i class="fa-solid fa-plus"></i> {{localize "SIEDLUNG.editor.add"}}</button>
    </header>
    <p class="hint">{{localize "SIEDLUNG.terrainEditor.hint"}}</p>
    <ul class="asset-list terrain-defs">
      <li class="asset-head">
        <span>{{localize "SIEDLUNG.editor.colorLabel"}}</span>
        <span>{{localize "SIEDLUNG.editor.nameLabel"}}</span>
        <span>{{localize "SIEDLUNG.terrainEditor.buildable"}}</span>
        <span></span>
      </li>
      {{#each terrain}}
      <li>
        <input type="color" value="{{color}}" data-terrain-field="color" data-id="{{id}}">
        <input type="text" value="{{label}}" data-terrain-field="label" data-id="{{id}}" maxlength="40">
        <input type="checkbox" data-terrain-field="buildable" data-id="{{id}}" {{#if buildable}}checked{{/if}} {{#if noToggle}}disabled{{/if}}>
        {{#if fixed}}<span title="{{localize 'SIEDLUNG.terrainEditor.errors.builtin'}}"><i class="fa-solid fa-lock"></i></span>{{else}}<button type="button" data-action="deleteTerrain" data-id="{{id}}" title="{{localize 'SIEDLUNG.terrainEditor.delete'}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
      </li>
      {{/each}}
    </ul>
  </section>
  {{else}}
  <section>
    <header>
      <h3>{{assetTitle}}</h3>
      <button type="button" data-action="addAsset" data-kind="{{assetKind}}"><i class="fa-solid fa-plus"></i> {{localize "SIEDLUNG.editor.add"}}</button>
    </header>
    <p class="hint">{{localize "SIEDLUNG.editor.valueHint"}}</p>
    {{#if isResource}}<p class="hint">{{localize "SIEDLUNG.editor.weightHint"}}</p>{{/if}}
    <ul class="asset-list with-order {{#if isResource}}with-weight{{/if}}">
      <li class="asset-head">
        <span>{{localize "SIEDLUNG.editor.colorLabel"}}</span>
        <span>{{localize "SIEDLUNG.editor.nameLabel"}}</span>
        <span>{{localize "SIEDLUNG.editor.valueLabel"}}</span>
        {{#if isResource}}<span>{{localize "SIEDLUNG.editor.weightLabel"}}</span><span>{{localize "SIEDLUNG.shortage.editor.column"}}</span>{{/if}}
        <span>{{localize "SIEDLUNG.editor.orderLabel"}}</span>
        <span></span>
      </li>
      {{#each assets}}
      <li>
        <input type="color" value="{{color}}" data-asset-field="color" data-kind="{{../assetKind}}" data-id="{{id}}">
        <input type="text" value="{{name}}" data-asset-field="name" data-kind="{{../assetKind}}" data-id="{{id}}" maxlength="40">
        <input type="number" value="{{value}}" min="0" step="0.01" data-asset-field="value" data-kind="{{../assetKind}}" data-id="{{id}}" {{#if fixed}}disabled{{/if}}>
        {{#if ../isResource}}<input type="number" value="{{weight}}" min="0" step="any" data-asset-field="weight" data-kind="{{../assetKind}}" data-id="{{id}}">{{/if}}
        {{#if ../isResource}}<button type="button" class="shortage-btn" data-action="editShortage" data-id="{{id}}" title="{{localize 'SIEDLUNG.shortage.editor.open'}}"><i class="fa-solid fa-triangle-exclamation"></i> {{shortageText}}</button>{{/if}}
        <span class="move-btns">
          <button type="button" data-action="moveAsset" data-dir="top" data-kind="{{../assetKind}}" data-id="{{id}}" title="{{localize 'SIEDLUNG.editor.moveTop'}}"><i class="fa-solid fa-angles-up"></i></button>
          <button type="button" data-action="moveAsset" data-dir="up" data-kind="{{../assetKind}}" data-id="{{id}}" title="{{localize 'SIEDLUNG.editor.moveUp'}}"><i class="fa-solid fa-angle-up"></i></button>
          <button type="button" data-action="moveAsset" data-dir="down" data-kind="{{../assetKind}}" data-id="{{id}}" title="{{localize 'SIEDLUNG.editor.moveDown'}}"><i class="fa-solid fa-angle-down"></i></button>
          <button type="button" data-action="moveAsset" data-dir="bottom" data-kind="{{../assetKind}}" data-id="{{id}}" title="{{localize 'SIEDLUNG.editor.moveBottom'}}"><i class="fa-solid fa-angles-down"></i></button>
        </span>
        {{#if fixed}}<span></span>{{else}}<button type="button" data-action="deleteAsset" data-kind="{{../assetKind}}" data-id="{{id}}" title="{{localize 'SIEDLUNG.editor.deleteAsset'}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  <footer>
    <button type="button" data-action="resetDefaults">{{localize "SIEDLUNG.editor.resetDefaults"}}</button>
  </footer>
</div>
