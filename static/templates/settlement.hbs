<div class="siedlung-settlement">
  <div class="week">
    <h3>{{weekLabel}}</h3>
    {{#if isGM}}<button type="button" data-action="nextWeek"><i class="fa-solid fa-forward"></i> {{localize "SIEDLUNG.settlement.nextWeek"}}</button>{{/if}}
  </div>

  <nav class="settlement-tabs">
    <button type="button" class="{{#if isLage}}active{{/if}}" data-action="switchTab" data-tab="lage">{{localize "SIEDLUNG.settlement.tabs.lage"}}</button>
    <button type="button" class="{{#if isBau}}active{{/if}}" data-action="switchTab" data-tab="bau">{{localize "SIEDLUNG.settlement.tabs.bau"}}{{#if constructionCount}} ({{constructionCount}}){{/if}}</button>
    <button type="button" class="{{#if isGebaeude}}active{{/if}}" data-action="switchTab" data-tab="gebaeude">{{localize "SIEDLUNG.settlement.tabs.buildings"}}{{#if builtCount}} ({{builtCount}}){{/if}}</button>
    <button type="button" class="{{#if isEinfluesse}}active{{/if}}" data-action="switchTab" data-tab="einfluesse">{{localize "SIEDLUNG.settlement.tabs.influences"}}{{#if influenceCount}} ({{influenceCount}}){{/if}}</button>
  </nav>

  {{#if isLage}}
  {{#if stats.length}}
  <section>
    <h4>{{localize "SIEDLUNG.settlement.stats"}}</h4>
    <ul class="stat-list">
      {{#each stats}}
      <li>
        <div class="stat-row">
          <span class="name">{{name}}</span>
          {{#if label}}<span class="pill" style="background: {{color}}; color: {{textColor}}">{{label}}</span>{{/if}}
          {{#if ../isGM}}<input type="number" step="any" min="{{min}}" {{#if isInterval}}max="{{max}}"{{/if}} value="{{base}}" data-stat-id="{{id}}">{{else}}<span class="amount">{{value}}</span>{{/if}}
        </div>
        {{#if note}}<div class="sub">{{localize "SIEDLUNG.effects.effective"}} {{value}} · {{note}}</div>{{/if}}
        {{#if isInterval}}<div class="bar"><span style="width: {{percent}}%; background: {{color}}"></span></div>{{/if}}
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  <section>
    <h4>{{localize "SIEDLUNG.settlement.resources"}}</h4>
    <ul class="stock-list">
      {{#each resources}}
      <li>
        <i class="dot" style="background: {{color}}"></i>
        <span class="name">{{name}}</span>
        <span class="trend {{trendClass}}" title="{{trendTitle}}">{{trend}}</span>
        {{#if ../isGM}}<input type="number" step="1" min="0" value="{{amount}}" data-stock-kind="resource" data-id="{{id}}">{{else}}<span class="amount">{{amount}}</span>{{/if}}
      </li>
      {{/each}}
    </ul>
  </section>

  <section>
    <h4>{{localize "SIEDLUNG.settlement.workers"}}</h4>
    <ul class="stock-list">
      {{#each workers}}
      <li>
        <i class="dot" style="background: {{color}}"></i>
        <span class="name">{{name}}</span>
        <span class="trend {{trendClass}}" title="{{trendTitle}}">{{trend}}</span>
        {{#if ../isGM}}<input type="number" step="1" min="0" value="{{base}}" data-stock-kind="worker" data-id="{{id}}">{{else}}<span class="amount">{{capacity}}</span>{{/if}}
        <span class="sub">{{free}} {{localize "SIEDLUNG.settlement.free"}}{{#if bound}} ({{bound}} {{localize "SIEDLUNG.settlement.bound"}}){{/if}}{{#if note}} · {{localize "SIEDLUNG.effects.effective"}} {{capacity}} ({{note}}){{/if}}</span>
      </li>
      {{/each}}
    </ul>
  </section>

  {{/if}}

  {{#if isGebaeude}}
  <section class="built">
    {{#each builtCategories}}
    <div class="cat" style="--cat: {{color}}">
      <h5>{{label}}</h5>
      {{#each groups}}
      <details data-group="{{key}}">
        <summary><span class="name">{{count}}× {{name}}</span></summary>
        <ul>
          {{#each items}}
          <li class="row"><span class="name">{{name}}</span>
            <button type="button" data-action="focusBuilding" data-id="{{id}}" title="{{localize 'SIEDLUNG.info.focus'}}"><i class="fa-solid fa-location-crosshairs"></i></button>
            <button type="button" data-action="infoBuilding" data-id="{{id}}" title="{{localize 'SIEDLUNG.settlement.details'}}"><i class="fa-solid fa-circle-info"></i></button>
          </li>
          {{/each}}
        </ul>
      </details>
      {{/each}}
    </div>
    {{else}}
    <p class="empty">{{localize "SIEDLUNG.settlement.noBuilt"}}</p>
    {{/each}}
  </section>
  {{/if}}

  {{#if isEinfluesse}}
  <section class="effects">
    <h4>{{localize "SIEDLUNG.effects.title"}}</h4>
    {{#if effects.length}}
    <ul class="effect-list">
      {{#each effects}}
      <li>
        <div class="effect-head">
          <strong>{{name}}</strong>
          {{#if ../isGM}}
          <span class="weeks"><input type="number" min="0" step="1" value="{{remaining}}" data-effect-id="{{id}}" title="{{localize 'SIEDLUNG.effects.durationHint'}}"> {{localize "SIEDLUNG.effects.weeksShort"}}</span>
          <button type="button" data-action="removeEffect" data-id="{{id}}" title="{{localize 'SIEDLUNG.effects.remove'}}"><i class="fa-solid fa-trash"></i></button>
          {{else}}
          <span class="weeks">{{remaining}} {{localize "SIEDLUNG.effects.weeksShort"}}</span>
          {{/if}}
        </div>
        <div class="chips">
          {{#each entries}}<span class="chip">{{#if color}}<i style="background: {{color}}"></i>{{/if}}{{text}}&nbsp;{{name}}{{#if perWeek}}&nbsp;{{localize "SIEDLUNG.effects.perWeek"}}{{/if}}</span>{{/each}}
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="empty">{{localize "SIEDLUNG.effects.none"}}</p>
    {{/if}}
    {{#if isGM}}<button type="button" data-action="addEffect"><i class="fa-solid fa-plus"></i> {{localize "SIEDLUNG.effects.add"}}</button>{{/if}}
  </section>

  {{#if triggerRows.length}}
  <section class="triggers">
    <h4>{{localize "SIEDLUNG.triggers.sectionTitle"}}</h4>
    <ul class="effect-list">
      {{#each triggerRows}}
      <li class="{{#if firing}}firing{{else}}idle{{/if}}">
        <div class="effect-head">
          <strong>{{name}}</strong>
          {{#if hidden}}<i class="fa-solid fa-eye-slash" title="{{localize 'SIEDLUNG.triggers.hidden'}}"></i>{{/if}}
          {{#if ../isGM}}<label class="switch"><input type="checkbox" data-trigger-id="{{id}}" {{#if on}}checked{{/if}}> {{localize "SIEDLUNG.triggers.active"}}</label>{{/if}}
          <span class="state">{{#if firing}}{{localize "SIEDLUNG.triggers.firing"}}{{else}}{{localize "SIEDLUNG.triggers.waiting"}}{{/if}}</span>
        </div>
        {{#if ../isGM}}<div class="sub">{{localize "SIEDLUNG.triggers.condition"}} {{#each conditions}}{{#unless @first}} ∧ {{/unless}}{{this}}{{/each}}</div>{{/if}}
        {{#if description}}<div class="sub">{{description}}</div>{{/if}}
        <div class="chips">
          {{#each entries}}<span class="chip">{{#if color}}<i style="background: {{color}}"></i>{{/if}}{{text}}&nbsp;{{name}}{{#if perWeek}}&nbsp;{{localize "SIEDLUNG.effects.perWeek"}}{{/if}}{{#if mode}}&nbsp;{{mode}}{{/if}}</span>{{/each}}
        </div>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{/if}}

  {{#if isBau}}
  <section>
    <h4>{{localize "SIEDLUNG.settlement.underConstruction"}}</h4>
    {{#if construction.length}}
    <ul class="build-list">
      {{#each construction}}
      <li>
        <strong>{{name}}</strong>
        <div class="bar-row"><span>{{localize "SIEDLUNG.settlement.material"}}</span><div class="bar"><span style="width: {{res}}%"></span></div><span>{{res}} %</span></div>
        <div class="bar-row"><span>{{localize "SIEDLUNG.settlement.work"}}</span><div class="bar"><span style="width: {{lab}}%"></span></div><span>{{lab}} %</span></div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="empty">{{localize "SIEDLUNG.settlement.noConstruction"}}</p>
    {{/if}}
  </section>
  {{/if}}
</div>
