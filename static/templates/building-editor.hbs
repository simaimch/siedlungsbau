<div class="siedlung-building-editor">
  <div class="form-group">
    <label>{{localize "SIEDLUNG.editor.name"}}</label>
    <input type="text" name="name" value="{{name}}" maxlength="60" autocomplete="off">
  </div>
  <div class="form-group">
    <label>{{localize "SIEDLUNG.editor.category"}}</label>
    <select name="category">
      {{#each categories}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
  </div>

  {{#each costLists}}
  <fieldset class="cost-list">
    <legend>{{label}}</legend>
    {{#if hint}}<p class="hint">{{hint}}</p>{{/if}}
    {{#each rows}}
    <div class="cost-row" data-list="{{../key}}">
      <select name="item">
        {{#each groups}}
        <optgroup label="{{label}}">
          {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </optgroup>
        {{/each}}
      </select>
      <input type="number" name="amount" value="{{amount}}" {{#unless ../allowNegative}}min="1"{{/unless}} step="1">
      <button type="button" data-action="removeCost" data-list="{{../key}}" data-index="{{index}}" title="{{localize 'SIEDLUNG.editor.removeCost'}}"><i class="fa-solid fa-xmark"></i></button>
    </div>
    {{/each}}
    <button type="button" data-action="addCost" data-list="{{key}}"><i class="fa-solid fa-plus"></i> {{localize "SIEDLUNG.editor.addCost"}}</button>
  </fieldset>
  {{/each}}

  {{#if hasStats}}
  <fieldset class="cost-list">
    <legend>{{localize "SIEDLUNG.editor.statEffects"}}</legend>
    <p class="hint">{{localize "SIEDLUNG.editor.statEffectsHint"}}</p>
    {{#each effectRows}}
    <div class="cost-row effect-row">
      <select name="stat">
        {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
      <input type="number" name="amount" value="{{amount}}" step="any">
      <select name="mode">
        <option value="weekly" {{#unless once}}selected{{/unless}}>{{localize "SIEDLUNG.editor.modeWeekly"}}</option>
        <option value="once" {{#if once}}selected{{/if}}>{{localize "SIEDLUNG.editor.modeOnce"}}</option>
      </select>
      <button type="button" data-action="removeEffect" data-index="{{index}}" title="{{localize 'SIEDLUNG.editor.removeEffect'}}"><i class="fa-solid fa-xmark"></i></button>
    </div>
    {{/each}}
    <button type="button" data-action="addEffect"><i class="fa-solid fa-plus"></i> {{localize "SIEDLUNG.editor.addEffect"}}</button>
  </fieldset>
  {{/if}}

  <div class="form-group size">
    <label>{{localize "SIEDLUNG.editor.width"}}</label>
    <input type="number" name="w" value="{{w}}" min="1" max="{{max}}">
    <label>{{localize "SIEDLUNG.editor.height"}}</label>
    <input type="number" name="h" value="{{h}}" min="1" max="{{max}}">
  </div>
  <p class="hint">{{localize "SIEDLUNG.editor.shape"}} – <span class="count">{{count}}</span> {{localize "SIEDLUNG.editor.fields"}}</p>
  <div class="shape-grid" style="--w: {{w}}">
    {{#each gridCells}}<button type="button" class="cell {{#if on}}on{{/if}}" data-action="toggleCell" data-x="{{x}}" data-y="{{y}}"></button>{{/each}}
  </div>
  <footer>
    <button type="button" data-action="save"><i class="fa-solid fa-check"></i> {{localize "SIEDLUNG.editor.save"}}</button>
    <button type="button" data-action="cancel">{{localize "SIEDLUNG.editor.cancel"}}</button>
  </footer>
</div>
