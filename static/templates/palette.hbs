<div class="siedlung-palette">
  <p class="hint">{{localize "SIEDLUNG.placement.hintShort"}}</p>
  {{#each categories}}
  <details open style="--cat: {{color}}">
    <summary>{{label}}</summary>
    <div class="list">
      {{#each buildings}}
      <button type="button" class="building" data-action="select" data-id="{{id}}">
        <span class="shape" style="--w: {{shape.w}}; --h: {{shape.h}}">
          {{#each shape.cells}}<i style="grid-column: {{col}}; grid-row: {{row}}"></i>{{/each}}
        </span>
        <span class="name">{{name}}</span>
        <span class="meta">{{count}} {{localize "SIEDLUNG.palette.fields"}}</span>
        {{#if buildCost.length}}<span class="costs"><b>{{localize "SIEDLUNG.palette.build"}}:</b> {{#each buildCost}}<span class="chip"><i style="background: {{color}}"></i>{{text}}&nbsp;{{name}}</span>{{/each}}</span>{{/if}}
        {{#if effects.length}}<span class="costs"><b>{{localize "SIEDLUNG.palette.effects"}}:</b> {{#each effects}}<span class="chip">{{text}}&nbsp;{{name}}&nbsp;({{#if once}}{{localize "SIEDLUNG.palette.once"}}{{else}}{{localize "SIEDLUNG.palette.weekly"}}{{/if}})</span>{{/each}}</span>{{/if}}
        {{#if upkeep.length}}<span class="costs"><b>{{localize "SIEDLUNG.palette.upkeep"}}:</b> {{#each upkeep}}<span class="chip"><i style="background: {{color}}"></i>{{text}}&nbsp;{{name}}</span>{{/each}}</span>{{/if}}
      </button>
      {{/each}}
    </div>
  </details>
  {{/each}}
  {{#if hasRoads}}
  <details open style="--cat: #a08060">
    <summary>{{localize "SIEDLUNG.roads.title"}}</summary>
    <p class="hint">{{localize "SIEDLUNG.roads.paletteHint"}}</p>
    <div class="list">
      {{#each roads}}
      <button type="button" class="building {{#if selected}}selected{{/if}}" data-action="pickRoad" data-id="{{id}}">
        <span class="shape" style="--w: 1; --h: 1"><i style="grid-column: 1; grid-row: 1; background: {{color}}"></i></span>
        <span class="name">{{name}}</span>
        <span class="meta">1 {{localize "SIEDLUNG.palette.fields"}}</span>
        {{#if costs.length}}<span class="costs"><b>{{localize "SIEDLUNG.palette.build"}}:</b> {{#each costs}}<span class="chip"><i style="background: {{color}}"></i>{{text}}&nbsp;{{name}}</span>{{/each}}</span>{{/if}}
      </button>
      {{/each}}
      <button type="button" class="building {{#if eraseSelected}}selected{{/if}}" data-action="roadMode" data-mode="erase">
        <span class="shape" style="--w: 1; --h: 1"><i style="grid-column: 1; grid-row: 1; background: #c0392b"></i></span>
        <span class="name">{{localize "SIEDLUNG.roads.erase"}}</span>
        <span class="meta">{{localize "SIEDLUNG.roads.eraseHint"}}</span>
      </button>
      {{#if isGM}}
      <button type="button" class="building {{#if completeSelected}}selected{{/if}}" data-action="roadMode" data-mode="complete">
        <span class="shape" style="--w: 1; --h: 1"><i style="grid-column: 1; grid-row: 1; background: #2ecc71"></i></span>
        <span class="name">{{localize "SIEDLUNG.roads.complete"}}</span>
        <span class="meta">{{localize "SIEDLUNG.roads.completeHint"}}</span>
      </button>
      {{/if}}
    </div>
  </details>
  {{/if}}
</div>
