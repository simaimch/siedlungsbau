<div class="siedlung-palette">
  <p class="hint">{{localize "SIEDLUNG.placement.hintShort"}}</p>
  {{#each categories}}
  <details open style="--cat: {{color}}">
    <summary>{{label}}</summary>
    <div class="list">
      {{#each buildings}}
      <button type="button" class="building" data-action="select" data-id="{{id}}">
        <span class="shape" style="--w: {{shape.w}}; --h: {{shape.h}}">
          {{#each shape.cells}}<i style="grid-column: {{col}}; grid-row: {{row}}"></i>{{/each}}
        </span>
        <span class="name">{{name}}</span>
        <span class="meta">{{count}} {{localize "SIEDLUNG.palette.fields"}}</span>
        {{#if buildCost.length}}<span class="costs"><b>{{localize "SIEDLUNG.palette.build"}}:</b> {{#each buildCost}}<span class="chip"><i style="background: {{color}}"></i>{{amount}}&nbsp;{{name}}</span>{{/each}}</span>{{/if}}
        {{#if upkeep.length}}<span class="costs"><b>{{localize "SIEDLUNG.palette.upkeep"}}:</b> {{#each upkeep}}<span class="chip"><i style="background: {{color}}"></i>{{amount}}&nbsp;{{name}}</span>{{/each}}</span>{{/if}}
      </button>
      {{/each}}
    </div>
  </details>
  {{/each}}
</div>
